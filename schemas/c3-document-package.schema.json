{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/iic/c3-document-package.schema.json",
  "title": "Private untrusted offline document package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "visibility",
    "valuation_usable",
    "identity",
    "raw_bytes_base64",
    "declared_sha256",
    "declared_origin",
    "declared_acquired_at",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "iic.c3-document-package.v1"
    },
    "visibility": {
      "const": "PRIVATE"
    },
    "valuation_usable": {
      "const": false
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer_cik",
        "accession",
        "document_name"
      ],
      "properties": {
        "issuer_cik": {
          "type": "string",
          "pattern": "^[0-9]{10}$",
          "maxLength": 10
        },
        "accession": {
          "type": "string",
          "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$",
          "maxLength": 20
        },
        "document_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "not": {
            "pattern": "[^A-Za-z0-9_.-]"
          }
        }
      }
    },
    "raw_bytes_base64": {
      "type": "string",
      "minLength": 4
    },
    "declared_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "declared_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "locator"
      ],
      "properties": {
        "kind": {
          "enum": [
            "FIXTURE",
            "IMPORTED"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "declared_acquired_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "reference"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
