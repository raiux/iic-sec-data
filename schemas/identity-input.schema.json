          "issuer_id": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "official_check": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "checked_at": {
                "type": "string",
                "format": "date-time"
              },
              "result": {
                "type": "string",
                "enum": [
                  "VERIFIED",
                  "UNVERIFIED",
                  "CONFLICT"
                ]
              }
            },
            "required": [
              "ref",
              "checked_at",
              "result"
            ],
            "additionalProperties": false
          },
          "access": {
            "type": "object",
            "properties": {
              "result": {
                "type": "string",
                "enum": [
                  "AVAILABLE",
                  "UNAVAILABLE",
                  "UNVERIFIED"
                ]
              },
              "authorization": {
                "type": "string",
                "enum": [
                  "AUTHORIZED",
                  "DENIED",
                  "UNVERIFIED"
                ]
              },
              "identity": {
                "type": "object",
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "checked_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "result": {
                    "type": "string",
                    "enum": [
                      "VERIFIED",
                      "UNVERIFIED",
                      "CONFLICT"
                    ]
                  }
                },
                "required": [
                  "ref",
                  "checked_at",
                  "result"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "result",
              "authorization",
              "identity"
            ],
            "additionalProperties": false
          },
          "filing": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "identity": {
                "type": "object",
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "checked_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "result": {
                    "type": "string",
                    "enum": [
                      "VERIFIED",
                      "UNVERIFIED",
                      "CONFLICT"
                    ]
                  }
                },
                "required": [
                  "ref",
                  "checked_at",
                  "result"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "ref",
              "identity"
            ],
            "additionalProperties": false
          },
          "xbrl": {
            "type": "object",
            "properties": {
              "taxonomy": {
                "type": "string",
                "minLength": 1
              },
              "identity": {
                "type": "object",
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "checked_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "result": {
                    "type": "string",
                    "enum": [
                      "VERIFIED",
                      "UNVERIFIED",
                      "CONFLICT"
                    ]
                  }
                },
                "required": [
                  "ref",
                  "checked_at",
                  "result"
                ],
                "additionalProperties": false
              }
            },
            "required": [
