            ],
            "additionalProperties": false
          }
        },
        "required": [
          "adapter",
          "issuer_id",
          "reference",
          "official_check",
          "access",
          "filing",
          "xbrl"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "issuer",
      "instrument",
      "listing"
    ],
    "additionalProperties": false
  }
}
