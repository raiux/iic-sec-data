{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/iic/annual-history.schema.json",
  "title": "Private untrusted annual report archive v1",
  "oneOf": [
    {
      "$ref": "#/$defs/report"
    },
    {
      "$ref": "#/$defs/history"
    }
  ],
  "$defs": {
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "issuer",
        "reporting_period",
        "received_at",
        "revision_kind",
        "revises",
        "source",
        "visibility",
        "valuation_usable"
      ],
      "properties": {
        "schema_version": {
          "const": "iic.annual-report.v1"
        },
        "issuer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheme",
            "identifier"
          ],
          "properties": {
            "scheme": {
              "enum": [
                "CIK",
                "LEI"
              ]
            },
            "identifier": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "reporting_period": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "maxLength": 10
            },
            "end": {
              "type": "string",
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "maxLength": 10
            }
          }
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "revision_kind": {
          "enum": [
            "INITIAL",
            "RESTATEMENT",
            "AMENDMENT",
            "UNKNOWN"
          ]
        },
        "revises": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "maxLength": 64
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "document_id",
            "filed_at",
            "locator",
            "raw_bytes_base64",
            "declared_sha256",
            "provenance"
          ],
          "properties": {
            "format": {
              "enum": [
                "SEC_SNAPSHOT",
                "ESEF_JSON"
              ]
            },
            "document_id": {
              "type": "string",
              "minLength": 1
            },
            "filed_at": {
              "type": "string",
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "maxLength": 10
            },
            "locator": {
              "type": "string",
              "minLength": 1
            },
            "raw_bytes_base64": {
              "type": "string",
              "minLength": 4
            },
            "declared_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "maxLength": 64
            },
            "provenance": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "reference"
              ],
              "properties": {
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "reference": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "visibility": {
          "const": "PRIVATE"
        },
        "valuation_usable": {
          "const": false
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "visibility",
        "valuation_usable",
        "reports",
        "retained_output"
      ],
      "properties": {
        "schema_version": {
          "const": "iic.annual-history.v1"
        },
        "visibility": {
          "const": "PRIVATE"
        },
        "valuation_usable": {
          "const": false
        },
        "reports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version_id",
              "input",
              "observations",
              "controls",
              "report_id"
            ],
            "properties": {
              "version_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "maxLength": 64
              },
              "input": {
                "$ref": "#/$defs/report"
              },
              "observations": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "controls": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_verification",
                  "accounting_validation",
                  "valuation_usable"
                ],
                "properties": {
                  "source_verification": {
                    "const": "NOT_PERFORMED"
                  },
                  "accounting_validation": {
                    "enum": [
                      "UNCHECKED",
                      "CONFLICT"
                    ]
                  },
                  "valuation_usable": {
                    "const": false
                  }
                }
              },
              "report_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "maxLength": 64
              }
            }
          }
        },
        "retained_output": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "generated_at",
                "reference",
                "raw_bytes_base64",
                "declared_sha256",
                "input_version_ids",
                "issuer"
              ],
              "properties": {
                "generated_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "reference": {
                  "type": "string",
                  "minLength": 1
                },
                "raw_bytes_base64": {
                  "type": "string",
                  "minLength": 4
                },
                "declared_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "maxLength": 64
                },
                "input_version_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$",
                    "maxLength": 64
                  }
                },
                "issuer": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "scheme",
                    "identifier"
                  ],
                  "properties": {
                    "scheme": {
                      "enum": [
                        "CIK",
                        "LEI"
                      ]
                    },
                    "identifier": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
